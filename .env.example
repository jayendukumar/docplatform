# Copy to .env only to override defaults. Never commit real secrets.
# Default Compose is a local-only development installation without authentication.
PLATFORM_HTTP_PORT=8000
PLATFORM_CONFIG_PATH=./config.toml
DOCPLATFORM_DB_PASSWORD=docplatform-local
# Existing volumes retain their original PostgreSQL password; changing this alone
# does not rotate it. Follow docs/e1-foundation.md for configuration details.
# DOCPLATFORM_STORAGE_BACKEND=s3
# DOCPLATFORM_S3_BUCKET=my-existing-bucket
# DOCPLATFORM_S3_ENDPOINT_URL=https://s3.example.com
# DOCPLATFORM_S3_REGION=us-east-1
# DOCPLATFORM_S3_ACCESS_KEY_ID=replace-me
# DOCPLATFORM_S3_SECRET_ACCESS_KEY=replace-me
